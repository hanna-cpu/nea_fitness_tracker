        <mxCell id="wOb7pYrqCbg5zpdAHGhP-6" value="link to register page if user does not have an account, simpler and easier for user to navigate&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
