        </mxCell>
        <!-- WeightRecord table -->
        <mxCell id="db1-Weight-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="222" width="240" height="136" as="geometry" />
        </mxCell>
        <mxCell id="db1-Weight-hdr" value="WeightRecord" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="222" width="240" height="32" as="geometry" />
        </mxCell>
        <mxCell id="db1-Weight-r1" value="PK  weight_id : INTEGER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=1;strokeColor=none;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="400" y="254" width="240" height="26" as="geometry" />
        </mxCell>
        <mxCell id="db1-Weight-r2" value="FK  user_id : INTEGER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=2;strokeColor=none;fillColor=#fff2cc;" vertex="1" parent="1">
