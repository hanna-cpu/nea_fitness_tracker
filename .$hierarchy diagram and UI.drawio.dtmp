          </mxGeometry>
        </mxCell>
        <mxCell id="wOb7pYrqCbg5zpdAHGhP-8" value="account linked to email so accounts dont get mixed up" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
