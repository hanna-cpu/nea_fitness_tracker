        <mxCell id="db1-Workout-r2" value="FK  user_id : INTEGER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontStyle=2;strokeColor=none;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="400" y="98" width="240" height="26" as="geometry" />
