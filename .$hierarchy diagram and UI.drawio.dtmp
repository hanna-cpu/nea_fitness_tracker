          <mxGeometry x="400" y="124" width="240" height="26" as="geometry" />
        </mxCell>
        <mxCell id="db1-Workout-r4" value="duration_minutes : INTEGER (NOT NULL)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
